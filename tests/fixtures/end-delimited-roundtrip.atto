fnc identity(int x) -> int :: return x; end

fnc identity_colon(int x) -> int :: return x; end

fnc classify(int x) -> int :: if x > 0 then return 1; else return 0; fi end

fnc callback() -> () => void ::
    return || -> { return; };
end

fnc text() -> string /* ; as do end */ :: return "do end fi;"; end

define module math as
    fnc double(int x) -> int :: return x + x; end
end
